{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(devflow_http_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(devflow_http_errors_total[1m])) / clamp_min(sum(rate(devflow_http_requests_total[1m])), 0.001)",
          "legendFormat": "errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Requests",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "devflow_active_requests",
          "legendFormat": "active"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [
        {
          "expr": "sum by (route) (rate(devflow_http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "95th Percentile Latency",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(devflow_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Orders Created",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [
        {
          "expr": "sum by (category) (rate(devflow_orders_created_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Calculations",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [
        {
          "expr": "sum by (operation) (rate(devflow_calculations_total[5m]))",
          "legendFormat": "{{operation}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["devflow", "prometheus"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "title": "DevFlow Application Monitoring",
  "version": 1
}
